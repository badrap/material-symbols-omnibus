{
  "name": "@badrap/material-symbols-omnibus",
  "version": "0.0.8",
  "type": "module",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badrap/material-symbols-omnibus.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": "./dist/index.js",
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --skipLibCheck --noEmit",
    "build": "rm -rf dist/* && tsc -p ./tsconfig.build.json",
    "generate": "rm -rf data/* && tsx scripts/generate.ts > src/_data.ts",
    "prepack": "npm run build",
    "changeset": "changeset",
    "bump": "changeset version",
    "release": "changeset publish"
  },
  "author": "Joachim Viide <jviide@iki.fi>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/badrap/material-symbols-omnibus/issues"
  },
  "homepage": "https://github.com/badrap/material-symbols-omnibus#readme",
  "devDependencies": {
    "@badrap/valita": "^0.4.6",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
